from __future__ import annotations

import argparse
import json
import os
import random
import shutil
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Iterable

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import tensorflow as tf
from tensorflow.keras import layers, regularizers
from tensorflow.keras.models import Model


# -----------------------------------------------------------------------------
# Default forecasting configuration
# -----------------------------------------------------------------------------
INPUT_HOURS = 72
OUTPUT_HOURS = 24
RANDOM_SEED = 21

FEATURE_COLUMNS = [
    "temperature_2m",
    "relative_humidity_2m",
    "surface_pressure",
    "wind_speed_10m",
    "cloud_cover",
    "precipitation",
    "is_day",
    "hour_sin",
    "hour_cos",
    "day_sin",
    "day_cos",
]
TARGET_COLUMN = "temperature_2m"
TEMPERATURE_FEATURE_INDEX = FEATURE_COLUMNS.index(TARGET_COLUMN)

TIME_COLUMN_CANDIDATES = ["time", "datetime", "timestamp", "date"]
GROUP_COLUMN_CANDIDATES = ["city", "location", "location_name"]


@tf.keras.utils.register_keras_serializable(package="Weather")
class PreviousDayTemperature(layers.Layer):
    """Extract the same 24 forecast hours from the previous observed day."""

    def __init__(self, output_hours: int, feature_index: int, **kwargs):
        super().__init__(**kwargs)
        self.output_hours = int(output_hours)
        self.feature_index = int(feature_index)

    def call(self, inputs):
        return inputs[:, -self.output_hours :, self.feature_index]

    def get_config(self):
        config = super().get_config()
        config.update(
            {
                "output_hours": self.output_hours,
                "feature_index": self.feature_index,
            }
        )
        return config


@tf.keras.utils.register_keras_serializable(package="Weather")
class HorizonEmbedding(layers.Layer):
    """Create a learned embedding for each of the 24 forecast horizons."""

    def __init__(self, output_hours: int, embedding_dim: int = 12, **kwargs):
        super().__init__(**kwargs)
        self.output_hours = int(output_hours)
        self.embedding_dim = int(embedding_dim)
        self.embedding = layers.Embedding(
            input_dim=self.output_hours,
            output_dim=self.embedding_dim,
            name="embedding",
        )

    def call(self, inputs):
        indices = tf.range(self.output_hours)
        embeddings = self.embedding(indices)
        embeddings = tf.expand_dims(embeddings, axis=0)
        return tf.tile(embeddings, [tf.shape(inputs)[0], 1, 1])

    def get_config(self):
        config = super().get_config()
        config.update(
            {
                "output_hours": self.output_hours,
                "embedding_dim": self.embedding_dim,
            }
        )
        return config


@dataclass(frozen=True)
class SequenceMetadata:
    group: str
    segment: int
    start_index: int
    forecast_start: str | None


def detect_column(dataframe: pd.DataFrame, candidates: Iterable[str]) -> str | None:
    return next((name for name in candidates if name in dataframe.columns), None)


def discover_project_root() -> Path:
    """Find a project folder containing data/splits, otherwise use cwd."""
    script_dir = Path(__file__).resolve().parent
    candidates = [Path.cwd(), script_dir, *script_dir.parents]

    for candidate in candidates:
        if (candidate / "data" / "splits").exists():
            return candidate

    return Path.cwd()


def set_reproducible_seed(seed: int) -> None:
    os.environ.setdefault("PYTHONHASHSEED", str(seed))
    random.seed(seed)
    np.random.seed(seed)
    tf.keras.utils.set_random_seed(seed)

    try:
        tf.config.experimental.enable_op_determinism()
    except Exception:
        # Some TensorFlow/platform combinations do not support deterministic ops.
        pass


def validate_dataframe(dataframe: pd.DataFrame, split_name: str) -> pd.DataFrame:
    missing = [column for column in FEATURE_COLUMNS if column not in dataframe.columns]
    if missing:
        raise ValueError(f"{split_name} is missing required columns: {missing}")

    dataframe = dataframe.copy()

    for column in FEATURE_COLUMNS:
        dataframe[column] = pd.to_numeric(dataframe[column], errors="coerce")

    invalid_counts = dataframe[FEATURE_COLUMNS].isna().sum()
    invalid_counts = invalid_counts[invalid_counts > 0]
    if not invalid_counts.empty:
        raise ValueError(
            f"{split_name} contains missing/non-numeric model values:\n"
            f"{invalid_counts.to_string()}"
        )

    dataframe[FEATURE_COLUMNS] = dataframe[FEATURE_COLUMNS].astype(np.float32)
    return dataframe


def split_into_contiguous_groups(
    dataframe: pd.DataFrame,
    split_name: str,
):
    """Yield city/location segments that contain uninterrupted hourly rows."""
    time_column = detect_column(dataframe, TIME_COLUMN_CANDIDATES)
    group_column = detect_column(dataframe, GROUP_COLUMN_CANDIDATES)
    working = dataframe.copy()

    if time_column is not None:
        working[time_column] = pd.to_datetime(working[time_column], errors="coerce")
        bad_count = int(working[time_column].isna().sum())
        if bad_count:
            raise ValueError(
                f"{split_name} contains {bad_count} invalid timestamps in "
                f"'{time_column}'."
            )

    grouped = (
        [("all", working)]
        if group_column is None
        else working.groupby(group_column, sort=False, dropna=False)
    )

    for group_name, group_df in grouped:
        group_df = group_df.copy()

        if time_column is None:
            yield str(group_name), 0, group_df.reset_index(drop=True), None
            continue

        group_df = group_df.sort_values(time_column).reset_index(drop=True)
        gap = group_df[time_column].diff().ne(pd.Timedelta(hours=1))
        group_df["_sequence_segment"] = gap.cumsum()

        for segment_id, segment_df in group_df.groupby(
            "_sequence_segment", sort=False
        ):
            yield (
                str(group_name),
                int(segment_id),
                segment_df.drop(columns="_sequence_segment").reset_index(drop=True),
                time_column,
            )


def create_sequences(
    dataframe: pd.DataFrame,
    split_name: str,
    stride: int,
):
    """Create 72-hour input windows paired with direct 24-hour targets."""
    X: list[np.ndarray] = []
    y: list[np.ndarray] = []
    metadata: list[SequenceMetadata] = []
    minimum_rows = INPUT_HOURS + OUTPUT_HOURS

    for group_name, segment_id, segment_df, time_column in split_into_contiguous_groups(
        dataframe, split_name
    ):
        if len(segment_df) < minimum_rows:
            continue

        features = segment_df[FEATURE_COLUMNS].to_numpy(dtype=np.float32)
        target = segment_df[TARGET_COLUMN].to_numpy(dtype=np.float32)
        last_start = len(segment_df) - minimum_rows + 1

        for start_index in range(0, last_start, stride):
            input_end = start_index + INPUT_HOURS
            target_end = input_end + OUTPUT_HOURS
            X.append(features[start_index:input_end])
            y.append(target[input_end:target_end])

            forecast_start = None
            if time_column is not None:
                forecast_start = segment_df.loc[input_end, time_column].isoformat()

            metadata.append(
                SequenceMetadata(
                    group=group_name,
                    segment=segment_id,
                    start_index=start_index,
                    forecast_start=forecast_start,
                )
            )

    if not X:
        raise ValueError(
            f"No {split_name} sequences were created. Every continuous location "
            f"segment needs at least {minimum_rows} hourly rows."
        )

    return (
        np.asarray(X, dtype=np.float32),
        np.asarray(y, dtype=np.float32),
        metadata,
    )


def build_model(X_train: np.ndarray) -> Model:
    """
    Improved residual 24-hour model.

    Improvements over the previous two-LSTM stack:
    - causal convolution for local temperature changes and fronts,
    - a larger recurrent encoder,
    - self-attention for long-range relationships across all 72 input hours,
    - average/max/last-state pooling so peaks are not represented by one state,
    - residual correction around the strong previous-day baseline.
    """
    normalizer = layers.Normalization(axis=-1, name="feature_normalization")
    normalizer.adapt(X_train.reshape(-1, X_train.shape[-1]))

    inputs = tf.keras.Input(
        shape=(INPUT_HOURS, X_train.shape[-1]),
        name="weather_sequence",
    )
    x = normalizer(inputs)

    # Local feature extraction. Causal padding prevents looking beyond the
    # historical input position being encoded.
    x = layers.Conv1D(
        64,
        kernel_size=5,
        padding="causal",
        activation="swish",
        kernel_regularizer=regularizers.l2(5e-5),
        name="causal_conv",
    )(x)
    conv_residual = x
    x = layers.SeparableConv1D(
        64,
        kernel_size=3,
        padding="causal",
        activation="swish",
        depthwise_regularizer=regularizers.l2(5e-5),
        pointwise_regularizer=regularizers.l2(5e-5),
        name="local_weather_block",
    )(x)
    x = layers.Dropout(0.10, name="conv_dropout")(x)
    x = layers.Add(name="conv_residual_add")([conv_residual, x])
    x = layers.LayerNormalization(name="conv_normalization")(x)

    # Recurrent encoder for trends spanning several hours or days.
    x = layers.LSTM(
        96,
        return_sequences=True,
        dropout=0.10,
        kernel_regularizer=regularizers.l2(5e-5),
        name="lstm_encoder",
    )(x)

    # Self-attention lets the model compare each historical period with every
    # other historical period, which is useful for repeating daily patterns.
    attention_output = layers.MultiHeadAttention(
        num_heads=4,
        key_dim=24,
        dropout=0.10,
        name="history_attention",
    )(x, x)
    x = layers.Add(name="attention_residual_add")([x, attention_output])
    x = layers.LayerNormalization(name="attention_normalization")(x)

    feed_forward = layers.Dense(192, activation="swish", name="attention_ff_1")(x)
    feed_forward = layers.Dropout(0.10, name="attention_ff_dropout")(feed_forward)
    feed_forward = layers.Dense(96, name="attention_ff_2")(feed_forward)
    x = layers.Add(name="feed_forward_residual_add")([x, feed_forward])
    x = layers.LayerNormalization(name="encoder_output_normalization")(x)

    # Use multiple summaries of the 72-hour history. Max pooling helps retain
    # extreme values; average pooling describes the overall regime; the last
    # state preserves the most recent conditions.
    average_context = layers.GlobalAveragePooling1D(name="average_context")(x)
    maximum_context = layers.GlobalMaxPooling1D(name="maximum_context")(x)
    latest_context = layers.Cropping1D(
        cropping=(INPUT_HOURS - 1, 0),
        name="latest_timestep_crop",
    )(x)
    latest_context = layers.Reshape((96,), name="latest_context")(latest_context)
    context = layers.Concatenate(name="combined_context")(
        [average_context, maximum_context, latest_context]
    )

    context = layers.Dense(
        160,
        activation="swish",
        kernel_regularizer=regularizers.l2(5e-5),
        name="forecast_features_1",
    )(context)
    context = layers.Dropout(0.20, name="forecast_dropout_1")(context)
    context = layers.Dense(
        80,
        activation="swish",
        kernel_regularizer=regularizers.l2(5e-5),
        name="forecast_features_2",
    )(context)
    context = layers.Dropout(0.10, name="forecast_dropout_2")(context)

    # Decode one correction per forecast hour. A learned horizon embedding lets
    # hour 1 and hour 24 use different correction behavior instead of sharing
    # an undifferentiated final Dense vector.
    repeated_context = layers.RepeatVector(OUTPUT_HOURS, name="repeat_context")(
        context
    )
    horizon_embedding = HorizonEmbedding(
        output_hours=OUTPUT_HOURS,
        embedding_dim=12,
        name="horizon_embedding",
    )(context)

    previous_day = PreviousDayTemperature(
        output_hours=OUTPUT_HOURS,
        feature_index=TEMPERATURE_FEATURE_INDEX,
        name="previous_day_temperature",
    )(inputs)
    previous_day_expanded = layers.Reshape(
        (OUTPUT_HOURS, 1),
        name="previous_day_expanded",
    )(previous_day)

    decoder = layers.Concatenate(name="horizon_decoder_input")(
        [repeated_context, horizon_embedding, previous_day_expanded]
    )
    decoder = layers.Dense(64, activation="swish", name="decoder_dense_1")(decoder)
    decoder = layers.Dropout(0.10, name="decoder_dropout")(decoder)
    decoder = layers.Dense(32, activation="swish", name="decoder_dense_2")(decoder)
    temperature_adjustment = layers.Dense(
        1,
        name="temperature_adjustment_per_hour",
    )(decoder)
    temperature_adjustment = layers.Reshape(
        (OUTPUT_HOURS,),
        name="temperature_adjustment",
    )(temperature_adjustment)

    outputs = layers.Add(name="temperature_prediction")(
        [previous_day, temperature_adjustment]
    )

    model = Model(inputs=inputs, outputs=outputs, name="weather_lstm_attention_24h")

    optimizer = tf.keras.optimizers.Adam(
        learning_rate=5e-4,
        clipnorm=1.0,
    )
    model.compile(
        optimizer=optimizer,
        loss=tf.keras.losses.Huber(delta=1.25),
        metrics=[
            tf.keras.metrics.MeanAbsoluteError(name="mae"),
            tf.keras.metrics.RootMeanSquaredError(name="rmse"),
        ],
    )
    return model


def calculate_forecast_metrics(actual: np.ndarray, predicted: np.ndarray) -> dict:
    errors = predicted - actual
    return {
        "overall_mae": float(np.mean(np.abs(errors))),
        "overall_rmse": float(np.sqrt(np.mean(np.square(errors)))),
        "overall_bias": float(np.mean(errors)),
        "max_absolute_error": float(np.max(np.abs(errors))),
        "mae_by_hour": np.mean(np.abs(errors), axis=0).astype(float).tolist(),
        "rmse_by_hour": np.sqrt(np.mean(np.square(errors), axis=0))
        .astype(float)
        .tolist(),
        "bias_by_hour": np.mean(errors, axis=0).astype(float).tolist(),
    }


def save_prediction_table(
    output_path: Path,
    actual: np.ndarray,
    predicted: np.ndarray,
    metadata: list[SequenceMetadata],
) -> None:
    records = []
    for sample_index, sample_meta in enumerate(metadata):
        for horizon_index in range(OUTPUT_HOURS):
            actual_value = float(actual[sample_index, horizon_index])
            predicted_value = float(predicted[sample_index, horizon_index])
            records.append(
                {
                    "sample": sample_index,
                    "forecast_hour": horizon_index + 1,
                    "group": sample_meta.group,
                    "segment": sample_meta.segment,
                    "forecast_start": sample_meta.forecast_start,
                    "actual": actual_value,
                    "predicted": predicted_value,
                    "error": predicted_value - actual_value,
                }
            )
    pd.DataFrame(records).to_csv(output_path, index=False)


def save_plots(
    figure_dir: Path,
    history: tf.keras.callbacks.History,
    y_test: np.ndarray,
    predictions: np.ndarray,
    forecast_metrics: dict,
    previous_day_metrics: dict,
) -> None:
    figure_dir.mkdir(parents=True, exist_ok=True)
    forecast_hours = np.arange(1, OUTPUT_HOURS + 1)

    plt.figure(figsize=(10, 6))
    plt.plot(history.history["loss"], label="Training Loss")
    plt.plot(history.history["val_loss"], label="Validation Loss")
    plt.title("Training vs Validation Loss")
    plt.xlabel("Epoch")
    plt.ylabel("Huber Loss")
    plt.legend()
    plt.grid(True)
    plt.savefig(figure_dir / "loss_curve.png", dpi=300, bbox_inches="tight")
    plt.close()

    plt.figure(figsize=(10, 6))
    plt.plot(history.history["mae"], label="Training MAE")
    plt.plot(history.history["val_mae"], label="Validation MAE")
    plt.title("Training vs Validation MAE")
    plt.xlabel("Epoch")
    plt.ylabel("Mean Absolute Error (°C)")
    plt.legend()
    plt.grid(True)
    plt.savefig(figure_dir / "mae_curve.png", dpi=300, bbox_inches="tight")
    plt.close()

    plt.figure(figsize=(12, 6))
    plt.plot(forecast_hours, y_test[0], marker="o", label="Actual Temperature")
    plt.plot(
        forecast_hours,
        predictions[0],
        marker="o",
        label="Predicted Temperature",
    )
    plt.title("Example 24-Hour Temperature Forecast")
    plt.xlabel("Forecast Hour")
    plt.ylabel("Temperature (°C)")
    plt.xticks(forecast_hours)
    plt.legend()
    plt.grid(True)
    plt.savefig(
        figure_dir / "forecast_24h_example.png",
        dpi=300,
        bbox_inches="tight",
    )
    plt.close()

    plt.figure(figsize=(12, 6))
    plt.plot(
        forecast_hours,
        forecast_metrics["mae_by_hour"],
        marker="o",
        label="Improved Model MAE",
    )
    plt.plot(
        forecast_hours,
        previous_day_metrics["mae_by_hour"],
        marker="o",
        label="Previous-Day Baseline MAE",
    )
    plt.title("MAE by Forecast Horizon")
    plt.xlabel("Forecast Hour")
    plt.ylabel("Mean Absolute Error (°C)")
    plt.xticks(forecast_hours)
    plt.legend()
    plt.grid(True)
    plt.savefig(
        figure_dir / "mae_by_forecast_hour.png",
        dpi=300,
        bbox_inches="tight",
    )
    plt.close()


def parse_args() -> argparse.Namespace:
    project_root = discover_project_root()
    parser = argparse.ArgumentParser(
        description="Train an improved 72-hour to 24-hour temperature model."
    )
    parser.add_argument(
        "--train-csv",
        type=Path,
        default=project_root / "data" / "splits" / "train.csv",
    )
    parser.add_argument(
        "--dev-csv",
        type=Path,
        default=project_root / "data" / "splits" / "dev.csv",
    )
    parser.add_argument(
        "--test-csv",
        type=Path,
        default=project_root / "data" / "splits" / "test.csv",
    )
    parser.add_argument(
        "--model-root",
        type=Path,
        default=project_root / "models" / "LSTM",
        help="Folder containing experiments/ and latest/.",
    )
    parser.add_argument("--epochs", type=int, default=100)
    parser.add_argument("--batch-size", type=int, default=64)
    parser.add_argument(
        "--stride",
        type=int,
        default=1,
        help="Window step in hours. Increase to reduce highly overlapping samples.",
    )
    parser.add_argument("--seed", type=int, default=RANDOM_SEED)
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    if args.epochs < 1 or args.batch_size < 1 or args.stride < 1:
        raise ValueError("epochs, batch-size, and stride must all be positive.")

    set_reproducible_seed(args.seed)

    for path in (args.train_csv, args.dev_csv, args.test_csv):
        if not path.exists():
            raise FileNotFoundError(f"Required data file not found: {path}")

    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    experiment_dir = args.model_root / "experiments" / timestamp
    latest_dir = args.model_root / "latest"
    figure_dir = experiment_dir / "figures"
    experiment_dir.mkdir(parents=True, exist_ok=True)
    latest_dir.mkdir(parents=True, exist_ok=True)

    model_path = experiment_dir / "weather_lstm.keras"
    latest_model_path = latest_dir / "weather_lstm.keras"
    config_path = experiment_dir / "model_config.json"
    latest_config_path = latest_dir / "model_config.json"
    metrics_path = experiment_dir / "metrics.json"
    history_path = experiment_dir / "training_history.csv"
    predictions_path = experiment_dir / "predictions.csv"
    summary_path = experiment_dir / "model_summary.txt"

    print("Loading datasets...")
    train_df = validate_dataframe(pd.read_csv(args.train_csv), "training data")
    dev_df = validate_dataframe(pd.read_csv(args.dev_csv), "development data")
    test_df = validate_dataframe(pd.read_csv(args.test_csv), "testing data")

    print("Creating contiguous forecast sequences...")
    X_train, y_train, train_metadata = create_sequences(
        train_df, "training data", args.stride
    )
    X_dev, y_dev, dev_metadata = create_sequences(dev_df, "development data", 1)
    X_test, y_test, test_metadata = create_sequences(test_df, "testing data", 1)

    print(f"Training samples    : {len(X_train)}")
    print(f"Development samples : {len(X_dev)}")
    print(f"Testing samples     : {len(X_test)}")
    print(f"Input shape         : {X_train.shape}")
    print(f"Target shape        : {y_train.shape}")

    model = build_model(X_train)
    model.summary()
    with summary_path.open("w", encoding="utf-8") as file:
        model.summary(print_fn=lambda line: file.write(line + "\n"))

    callbacks = [
        tf.keras.callbacks.EarlyStopping(
            monitor="val_mae",
            mode="min",
            patience=10,
            min_delta=0.002,
            restore_best_weights=True,
            verbose=1,
        ),
        tf.keras.callbacks.ReduceLROnPlateau(
            monitor="val_mae",
            mode="min",
            factor=0.5,
            patience=4,
            min_delta=0.001,
            min_lr=1e-6,
            verbose=1,
        ),
        tf.keras.callbacks.ModelCheckpoint(
            filepath=model_path,
            monitor="val_mae",
            mode="min",
            save_best_only=True,
            verbose=1,
        ),
        tf.keras.callbacks.TerminateOnNaN(),
    ]

    print("\nBeginning training...\n")
    history = model.fit(
        X_train,
        y_train,
        validation_data=(X_dev, y_dev),
        epochs=args.epochs,
        batch_size=args.batch_size,
        callbacks=callbacks,
        shuffle=True,
        verbose=1,
    )
    pd.DataFrame(history.history).to_csv(history_path, index=False)

    # Reload the exact best checkpoint before final evaluation and publishing.
    model = tf.keras.models.load_model(
        model_path,
        custom_objects={
            "PreviousDayTemperature": PreviousDayTemperature,
            "Weather>PreviousDayTemperature": PreviousDayTemperature,
            "HorizonEmbedding": HorizonEmbedding,
            "Weather>HorizonEmbedding": HorizonEmbedding,
        },
    )

    evaluation = model.evaluate(X_test, y_test, verbose=0, return_dict=True)
    predictions = np.asarray(model.predict(X_test, verbose=0), dtype=np.float32)
    forecast_metrics = calculate_forecast_metrics(y_test, predictions)

    last_observed = X_test[:, -1, TEMPERATURE_FEATURE_INDEX]
    persistence_predictions = np.repeat(
        last_observed[:, np.newaxis], OUTPUT_HOURS, axis=1
    )
    previous_day_predictions = X_test[
        :, -OUTPUT_HOURS:, TEMPERATURE_FEATURE_INDEX
    ]
    persistence_metrics = calculate_forecast_metrics(y_test, persistence_predictions)
    previous_day_metrics = calculate_forecast_metrics(y_test, previous_day_predictions)

    metrics = {
        "keras_evaluation": {key: float(value) for key, value in evaluation.items()},
        "improved_model": forecast_metrics,
        "persistence_baseline": persistence_metrics,
        "previous_day_baseline": previous_day_metrics,
        "improvement_vs_previous_day_mae_percent": float(
            100.0
            * (
                previous_day_metrics["overall_mae"]
                - forecast_metrics["overall_mae"]
            )
            / previous_day_metrics["overall_mae"]
        ),
    }

    with metrics_path.open("w", encoding="utf-8") as file:
        json.dump(metrics, file, indent=4)

    save_prediction_table(predictions_path, y_test, predictions, test_metadata)
    save_plots(
        figure_dir,
        history,
        y_test,
        predictions,
        forecast_metrics,
        previous_day_metrics,
    )

    # Save and publish the best model/config to the stable latest directory.
    model.save(model_path)
    shutil.copy2(model_path, latest_model_path)

    config = {
        "model_name": model.name,
        "input_hours": INPUT_HOURS,
        "output_hours": OUTPUT_HOURS,
        "feature_columns": FEATURE_COLUMNS,
        "target_column": TARGET_COLUMN,
        "temperature_feature_index": TEMPERATURE_FEATURE_INDEX,
        "uses_previous_day_baseline": True,
        "time_column_candidates": TIME_COLUMN_CANDIDATES,
        "group_column_candidates": GROUP_COLUMN_CANDIDATES,
        "created_at": timestamp,
        "training_files": {
            "train": str(args.train_csv.resolve()),
            "dev": str(args.dev_csv.resolve()),
            "test": str(args.test_csv.resolve()),
        },
    }
    with config_path.open("w", encoding="utf-8") as file:
        json.dump(config, file, indent=4)
    shutil.copy2(config_path, latest_config_path)

    print("\nTest results")
    print("-" * 60)
    print(f"Test MAE              : {forecast_metrics['overall_mae']:.4f} °C")
    print(f"Test RMSE             : {forecast_metrics['overall_rmse']:.4f} °C")
    print(f"Overall bias          : {forecast_metrics['overall_bias']:+.4f} °C")
    print(f"Persistence MAE       : {persistence_metrics['overall_mae']:.4f} °C")
    print(f"Previous-day MAE      : {previous_day_metrics['overall_mae']:.4f} °C")
    print(
        "MAE improvement vs previous day: "
        f"{metrics['improvement_vs_previous_day_mae_percent']:.2f}%"
    )
    print(f"\nExperiment saved to: {experiment_dir}")
    print(f"Latest model saved to: {latest_model_path}")


if __name__ == "__main__":
    main()